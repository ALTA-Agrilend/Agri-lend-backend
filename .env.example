# Copied to .env by pydantic-settings. All fields are optional; env vars override.

ENVIRONMENT=production
DEBUG=false

# Render injects DATABASE_URL automatically from the attached Postgres instance.
# The app normalizes postgres:// and postgresql:// URLs for asyncpg at startup.
# Local dev falls back to SQLite when this is unset.

# Generate a strong secret in production, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]
